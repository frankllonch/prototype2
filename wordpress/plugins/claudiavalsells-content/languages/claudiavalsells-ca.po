msgstr "Exposicions"

#: includes/import-admin.php:37 includes/post-types.php:101
#: includes/post-types.php:102
msgid "What’s Color?"
msgstr "What’s Color?"

#: includes/import-admin.php:38
msgid "About and Color Chart"
msgstr "About i Color Chart"

#: includes/import-admin.php:39
