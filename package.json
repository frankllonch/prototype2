{
  "name": "claudia-valsells",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "claudiavalsells.com — static site built from the WordPress content. WordPress stays the CMS.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "extract": "node --experimental-strip-types scripts/extract.ts",
    "images": "node --experimental-strip-types scripts/images.ts",
    "add-works": "node --experimental-strip-types scripts/add-works.ts",
    "crop": "node --experimental-strip-types scripts/crop.ts",
    "match-crops": "node --experimental-strip-types scripts/match-crops.ts",
    "match-review": "node --experimental-strip-types scripts/match-review.ts",
    "apply-crops": "node --experimental-strip-types scripts/apply-crops.ts",
    "uncropped": "node --experimental-strip-types scripts/uncropped.ts",
    "film": "node --experimental-strip-types scripts/film.ts",
    "build": "node --experimental-strip-types src/build.ts",
    "serve": "node --experimental-strip-types scripts/serve.ts",
    "dev": "npm run build && npm run serve",
    "deploy": "node --experimental-strip-types scripts/deploy.ts",
    "typecheck": "tsc --noEmit",
    "palette": "node --experimental-strip-types scripts/palette.ts",
    "wp:export": "node --experimental-strip-types scripts/wp-export.ts",
    "wp:assets": "node --experimental-strip-types scripts/wp-assets.ts",
    "wp:start": "cd wordpress && npx wp-env start",
    "wp:stop": "cd wordpress && npx wp-env stop",
    "wp:import": "cd wordpress && npx wp-env run cli wp eval-file wp-content/plugins/claudiavalsells-content/import.php",
    "wp:diff": "node --experimental-strip-types scripts/wp-diff.ts",
    "wp:check-links": "node --experimental-strip-types scripts/wp-check-links.ts",
    "wp:package": "node --experimental-strip-types scripts/wp-package.ts",
    "wp:rehearsal": "cd wordpress/rehearsal && npx wp-env start",
    "add-shows": "node --experimental-strip-types scripts/add-shows.ts",
    "add-chart-photos": "node --experimental-strip-types scripts/add-chart-photos.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@wordpress/env": "^12.0.0",
    "node-html-parser": "^7.0.1",
    "sharp": "^0.34.2",
    "typescript": "^5.7.2"
  }
}
